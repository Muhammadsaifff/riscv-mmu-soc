library (SoC_Hardened) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 1.80;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
  }
  type ("gpio") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("SoC_Hardened") {
    area : 1360323.125 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.1573;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("1.03909");
	}
	cell_fall(scalar) {
          values("0.80013");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("1.25711");
	}
	cell_fall(scalar) {
          values("1.05161");
	}
      }
    }
    pin("reset") {
      direction : input;
      capacitance : 0.1225;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.02821");
	}
	fall_constraint(scalar) {
          values("0.75336");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("1.69963");
	}
	fall_constraint(scalar) {
          values("1.63257");
	}
      }
    }
    pin("uart_tx") {
      direction : output;
      capacitance : 0.0006;
    }
    bus("gpio") {
      bus_type : gpio;
      direction : output;
      capacitance : 0.0000;
    pin("gpio[3]") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("4.24054,4.24450,4.25892,4.30622,4.50220,5.40401,9.57549");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("0.02663,0.02930,0.04048,0.09440,0.36978,1.66377,7.65036");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("4.26079,4.26351,4.27326,4.30194,4.39301,4.78079,6.58135");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("0.01880,0.02039,0.02678,0.05118,0.15999,0.69308,3.19064");
	}
      }
    }
    pin("gpio[2]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("gpio[1]") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("4.15463,4.15703,4.16663,4.20131,4.34185,4.98378,7.95189");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("0.02057,0.02258,0.03151,0.07164,0.26606,1.18254,5.39496");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("3.91234,3.91437,3.92192,3.94502,4.01376,4.28546,5.53257");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("0.01902,0.02031,0.02517,0.04341,0.11877,0.48589,2.21309");
	}
      }
    }
    pin("gpio[0]") {
      direction : output;
      capacitance : 0.0007;
    }
    }
  }

}

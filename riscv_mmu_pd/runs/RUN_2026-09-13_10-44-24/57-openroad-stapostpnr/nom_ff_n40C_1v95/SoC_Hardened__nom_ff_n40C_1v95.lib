library (SoC_Hardened) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 1.95;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
  }
  type ("gpio") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("SoC_Hardened") {
    area : 1360323.125 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.1575;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.71108");
	}
	cell_fall(scalar) {
          values("0.56904");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.85599");
	}
	cell_fall(scalar) {
          values("0.73763");
	}
      }
    }
    pin("reset") {
      direction : input;
      capacitance : 0.1224;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("0.06981");
	}
	fall_constraint(scalar) {
          values("0.50428");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("1.07047");
	}
	fall_constraint(scalar) {
          values("1.03087");
	}
      }
    }
    pin("uart_tx") {
      direction : output;
      capacitance : 0.0006;
    }
    bus("gpio") {
      bus_type : gpio;
      direction : output;
      capacitance : 0.0000;
    pin("gpio[3]") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("2.72797,2.73091,2.74144,2.77621,2.92326,3.60248,6.73669");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("0.01970,0.02184,0.03063,0.07130,0.28221,1.27347,5.85103");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("2.77769,2.77968,2.78710,2.80887,2.87571,3.15902,4.47196");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("0.01479,0.01622,0.02127,0.03898,0.11772,0.50981,2.34634");
	}
      }
    }
    pin("gpio[2]") {
      direction : output;
      capacitance : 0.0009;
    }
    pin("gpio[1]") {
      direction : output;
      capacitance : 0.0006;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("2.62579,2.62760,2.63478,2.66060,2.76578,3.24554,5.46320");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("0.01583,0.01734,0.02403,0.05418,0.20238,0.90260,4.12581");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("2.57569,2.57704,2.58254,2.59971,2.65056,2.84954,3.76478");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("0.01417,0.01522,0.01898,0.03271,0.08791,0.35795,1.63436");
	}
      }
    }
    pin("gpio[0]") {
      direction : output;
      capacitance : 0.0007;
    }
    }
  }

}

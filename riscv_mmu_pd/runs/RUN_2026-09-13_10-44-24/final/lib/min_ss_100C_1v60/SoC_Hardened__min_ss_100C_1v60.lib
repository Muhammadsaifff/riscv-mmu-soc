library (SoC_Hardened) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 100.0;
  nom_voltage                    : 1.60;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
  }
  type ("gpio") {
    base_type : array;
    data_type : bit;
    bit_width : 4;
    bit_from : 3;
    bit_to : 0;
  }

  cell ("SoC_Hardened") {
    area : 1360323.125 
    is_macro_cell : true;
    pin("clk") {
      direction : input;
      clock : true;
      capacitance : 0.1470;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("1.72993");
	}
	cell_fall(scalar) {
          values("1.37091");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("2.12623");
	}
	cell_fall(scalar) {
          values("1.82122");
	}
      }
    }
    pin("reset") {
      direction : input;
      capacitance : 0.1145;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.04236");
	}
	fall_constraint(scalar) {
          values("1.24982");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("3.30686");
	}
	fall_constraint(scalar) {
          values("3.07723");
	}
      }
    }
    pin("uart_tx") {
      direction : output;
      capacitance : 0.0006;
    }
    bus("gpio") {
      bus_type : gpio;
      direction : output;
      capacitance : 0.0000;
    pin("gpio[3]") {
      direction : output;
      capacitance : 0.0007;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("7.90234,7.90852,7.93130,8.00732,8.31642,9.74110,16.38845");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("0.04098,0.04558,0.06363,0.14846,0.57565,2.57549,11.85290");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("7.83939,7.84385,7.86010,7.90861,8.06459,8.73844,11.85729");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("0.02941,0.03225,0.04349,0.08645,0.27774,1.21116,5.54717");
	}
      }
    }
    pin("gpio[2]") {
      direction : output;
      capacitance : 0.0008;
    }
    pin("gpio[1]") {
      direction : output;
      capacitance : 0.0005;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("7.77811,7.78188,7.79704,7.85182,8.07381,9.08035,13.75388");
	}
	rise_transition(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("0.03223,0.03541,0.04943,0.11218,0.41330,1.82266,8.34568");
	}
	cell_fall(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("7.27573,7.27897,7.29136,7.33020,7.44604,7.91138,10.04694");
	}
	fall_transition(template_1) {
          index_1("0.00050,  0.00232,  0.01077,  0.05000,  0.23208,  1.07722,  5.00000");
          values("0.03136,0.03338,0.04159,0.07296,0.20244,0.83427,3.79761");
	}
      }
    }
    pin("gpio[0]") {
      direction : output;
      capacitance : 0.0007;
    }
    }
  }

}
